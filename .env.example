# ─────────────────────────────────────────────────────────────
# Room Inventory & Usage Monitoring System — environment template
# Copy to /etc/roomsys/.env on the server (chmod 600) and fill in.
# Never commit the real .env to git.
# ─────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=rooms.uz.ac.zw,localhost,127.0.0.1

# PostgreSQL (native install, localhost only — see ARCHITECTURE.md §8)
DATABASE_URL=postgres://postgres:bothy1210@127.0.0.1:5432/roomsys

# Email (booking notifications & reminders)
EMAIL_HOST=smtp.uz.ac.zw
EMAIL_PORT=587
EMAIL_HOST_USER=roomsys@uz.ac.zw
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=UZ Room System <roomsys@uz.ac.zw>

# Security (set True in production behind HTTPS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Institution branding
INSTITUTION_NAME=University of Zimbabwe
